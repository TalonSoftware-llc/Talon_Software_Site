# Throwaway local fixtures for the hybrid prototype. Not production credentials.
# Copy to .env if you want to change them. npm test reads this file directly.

POSTGRES_PASSWORD=dev-only-postgres
POSTGRES_PORT=54329
DATABASE_URL=postgres://hybrid_app:dev-only-hybrid-app@127.0.0.1:54329/hybrid
ADMIN_DATABASE_URL=postgres://postgres:dev-only-postgres@127.0.0.1:54329/hybrid

OIDC_ISSUER=http://127.0.0.1:4180
OIDC_PORT=4180
OIDC_CLIENT_ID=talon-hybrid-portal
OIDC_CLIENT_SECRET=dev-only-portal-client-secret-not-production
OIDC_COOKIE_KEY=dev-only-oidc-cookie-key
# ID tokens from this dev IdP use the portal client id as the audience.
OIDC_AUDIENCE=talon-hybrid-portal

SESSION_SECRET=dev-only-session-secret
PORTAL_ORIGIN=http://127.0.0.1:3210
PORTAL_PORT=3210
DATA_PLANE_ORIGIN=http://127.0.0.1:8088
DATA_PLANE_PORT=8088

# Sample IdP users. Authorization (tenant and role) is NOT here. It is in Postgres.
USER_ADA_PASSWORD=dev-only-ada
