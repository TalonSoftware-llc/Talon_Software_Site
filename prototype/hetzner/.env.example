# Local stand-in values for the throwaway prototype.
# Copy to .env only if you want to override docker-compose.yml defaults.
# Do not put real passwords, API keys, or client data here.

POSTGRES_PASSWORD=talon_dev_only

# The API role password is fixed in db/init.sql for this prototype:
# talon_app / talon_app_dev_only

# Dev IdP (not Entra, not Google). Sample users and the MFA code live in fixtures.js.
ISSUER=http://localhost:5556

# API
DATABASE_URL=postgres://talon_app:talon_app_dev_only@postgres:5432/talon_prototype
OIDC_ISSUER=http://localhost:5556
OIDC_JWKS_URL=http://auth:5556/jwks
OIDC_AUDIENCE=talon-api
PROTOTYPE_DEV=1
BLOB_DIR=/data/blobs

# Production mail is not configured. SendGrid is not an option.
# When a provider is chosen, put its API key only in the host environment.
# MAIL_API_KEY=
