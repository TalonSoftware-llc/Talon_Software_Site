# Throwaway Vercel pathway prototype. Not for production.
# Copy values into the repo-root .env.local (gitignored) or export them.
# Do not commit real secrets. Do not point this at a production database.

# Local dev SSO. Start it with: npm run prototype:vercel:oidc
PROTOTYPE_DEV=1
PROTOTYPE_OIDC_ISSUER=http://127.0.0.1:3098
PROTOTYPE_OIDC_PORT=3098
PROTOTYPE_APP_ORIGIN=http://127.0.0.1:3210

# Required outside local dev. At least 32 characters. Generate your own.
# PROTOTYPE_SESSION_SECRET=

# Neon connection string for a free dev branch. Leave unset to use embedded
# Postgres (PGlite) on this machine. Creating the Neon database needs Kendall.
# PROTOTYPE_DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
